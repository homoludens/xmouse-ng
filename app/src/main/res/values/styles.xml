<resources>

    <!-- Base application theme. -->
    <!-- Every qualified AppTheme inherits this complete theme. A qualified style
         without an explicit parent can replace the base bag's Material parent. -->
    <style name="Base.XMouseNg" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/ng_accent</item>
        <item name="colorPrimaryDark">@color/ng_accent</item>
        <item name="colorAccent">@color/ng_accent</item>
        <item name="colorSecondary">@color/ng_accent</item>
        <item name="colorOnPrimary">@color/ng_on_accent</item>
        <item name="colorOnSecondary">@color/ng_on_accent</item>
        <item name="colorSurface">@color/ng_surface</item>
        <item name="colorOnSurface">@color/ng_text_primary</item>
        <item name="colorControlNormal">@color/ng_text_secondary</item>
        <item name="colorControlActivated">@color/ng_accent</item>
        <item name="android:colorBackground">@color/ng_background</item>
        <item name="android:windowBackground">@color/ng_background</item>
        <item name="android:textColorPrimary">@color/ng_text_primary</item>
        <item name="android:textColorSecondary">@color/ng_text_secondary</item>
        <item name="android:statusBarColor">@color/ng_background</item>
        <item name="android:navigationBarColor">@color/ng_navigation_bar</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme" parent="Base.XMouseNg" />

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/ng_on_accent</item>
        <item name="android:textColorSecondary">@color/ng_on_accent</item>
        <item name="colorControlNormal">@color/ng_on_accent</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat" />

    <style name="TextAppearance.XMouseNg.Heading" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">23sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/ng_text_primary</item>
    </style>

    <!-- Explicitly applied by the redesigned Views; legacy Button/ToggleButton
         widget classes retain their existing casts and compound-drawable behavior. -->
    <style name="Widget.XMouseNg.ControlButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">13sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:minWidth">@dimen/ng_min_touch_target</item>
        <item name="android:minHeight">@dimen/ng_min_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">18dp</item>
        <item name="cornerRadius">@dimen/ng_radius_control</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/ng_border</item>
        <item name="backgroundTint">@color/ng_surface</item>
        <item name="android:textColor">@color/ng_text_primary</item>
    </style>

    <style name="Widget.XMouseNg.ControlButton.Soft" parent="Widget.XMouseNg.ControlButton">
        <item name="backgroundTint">@color/ng_surface_soft</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.XMouseNg.ControlButton.Pill" parent="Widget.XMouseNg.ControlButton">
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ng_accent</item>
        <item name="iconTint">@color/ng_accent</item>
        <item name="iconSize">16dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Widget.XMouseNg.ControlButton.Text" parent="Widget.XMouseNg.ControlButton">
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/ng_accent</item>
        <item name="iconTint">@color/ng_accent</item>
    </style>

    <style name="Widget.XMouseNg.ControlButton.Accent" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">13sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:minWidth">@dimen/ng_min_touch_target</item>
        <item name="android:minHeight">@dimen/ng_min_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/ng_radius_control</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/ng_accent</item>
        <item name="backgroundTint">@color/ng_accent</item>
        <item name="android:textColor">@color/ng_on_accent</item>
    </style>

    <style name="Widget.XMouseNg.ControlButton.Danger" parent="Widget.XMouseNg.ControlButton">
        <item name="backgroundTint">@color/ng_danger_soft</item>
        <item name="android:textColor">@color/ng_danger</item>
    </style>

    <style name="Widget.XMouseNg.KeyCategory" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minWidth">68dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@color/ng_key_category_background</item>
        <item name="android:textColor">@color/ng_key_category_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="TextAppearance.XMouseNg.KeySection" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/ng_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.XMouseNg.Navigation" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.XMouseNg.IconButton" parent="Widget.XMouseNg.ControlButton.Soft">
        <item name="android:minWidth">@dimen/ng_min_touch_target</item>
        <item name="android:minHeight">@dimen/ng_min_touch_target</item>
        <item name="iconSize">@dimen/ng_icon_size</item>
        <item name="iconTint">@color/ng_text_secondary</item>
    </style>

    <style name="Widget.XMouseNg.IconButton.Transparent" parent="Widget.XMouseNg.IconButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="iconSize">16dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.XMouseNg.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/ng_surface</item>
        <item name="boxStrokeColor">@color/ng_field_stroke</item>
        <item name="boxCornerRadiusTopStart">@dimen/ng_radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/ng_radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/ng_radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/ng_radius_control</item>
        <item name="hintTextColor">@color/ng_text_secondary</item>
    </style>

    <style name="Widget.XMouseNg.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:minHeight">@dimen/ng_min_touch_target</item>
        <item name="android:textColor">@color/ng_text_primary</item>
        <item name="android:textColorHint">@color/ng_text_secondary</item>
    </style>

</resources>
