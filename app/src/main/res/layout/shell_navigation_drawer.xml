<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shell_navigation_drawer"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ng_surface" android:fillViewport="true"
    android:accessibilityPaneTitle="@string/ng_navigation_menu"
    android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingTop="16dp" android:paddingBottom="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="2dp" android:paddingEnd="2dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/app_name" android:textColor="@color/ng_text_primary"
                    android:textSize="17sp" android:fontFamily="sans-serif-medium" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/ng_navigation_subtitle" android:textColor="@color/ng_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageButton android:id="@+id/drawer_close" android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:padding="14dp"
                android:src="@drawable/ic_ng_close" android:contentDescription="@string/ng_close_menu" />
        </LinearLayout>

        <TextView style="@style/TextAppearance.XMouseNg.Section" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginTop="14dp"
            android:text="@string/ng_drawer_connection" />
        <Button android:id="@+id/drawer_computers" style="@style/Widget.XMouseNg.ControlButton.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:gravity="start|center_vertical"
            android:text="@string/ng_computers" />
        <TextView style="@style/TextAppearance.XMouseNg.Section" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginTop="14dp"
            android:text="@string/ng_drawer_input" />
        <Button android:id="@+id/drawer_pointer_settings" style="@style/Widget.XMouseNg.ControlButton.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:gravity="start|center_vertical"
            android:text="@string/ng_pointer_settings" />
        <Button android:id="@+id/drawer_keyboard_settings" style="@style/Widget.XMouseNg.ControlButton.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:gravity="start|center_vertical"
            android:text="@string/ng_keyboard_settings" />

        <TextView style="@style/TextAppearance.XMouseNg.Section" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginTop="14dp"
            android:text="@string/ng_drawer_tools" />
        <Button android:id="@+id/drawer_authentication" style="@style/Widget.XMouseNg.ControlButton.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:gravity="start|center_vertical"
            android:text="@string/ng_authentication_settings" />

        <TextView style="@style/TextAppearance.XMouseNg.Section" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginTop="14dp"
            android:text="@string/ng_drawer_app" />
        <Button android:id="@+id/drawer_appearance" style="@style/Widget.XMouseNg.ControlButton.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:gravity="start|center_vertical"
            android:text="@string/ng_appearance" />
        <Button android:id="@+id/drawer_about" style="@style/Widget.XMouseNg.ControlButton.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:gravity="start|center_vertical"
            android:text="@string/ng_about" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginTop="14dp"
            android:background="@color/ng_border" />
        <Button android:id="@+id/drawer_exit" style="@style/Widget.XMouseNg.ControlButton.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="4dp"
            android:gravity="start|center_vertical" android:text="@string/ng_disconnect_and_exit"
            android:textColor="@color/ng_danger" />
    </LinearLayout>
</ScrollView>
