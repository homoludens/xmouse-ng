<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ng_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">
        <Button
            android:id="@+id/settings_back"
            style="@style/Widget.XMouseNg.ControlButton.Soft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:text="@string/ng_settings_back" />
        <TextView
            style="@style/TextAppearance.XMouseNg.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/title_activity_settings" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <Button
                android:id="@+id/settings_pointer_speed"
                style="@style/Widget.XMouseNg.ControlButton.Soft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:singleLine="false"
                android:textAllCaps="false"
                android:saveEnabled="false"
                android:text="@string/ng_settings_pointer_speed" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ng_text_secondary"
                android:text="@string/ng_settings_pointer_help" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/settings_natural_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:saveEnabled="false"
                android:textColor="@color/ng_text_primary"
                android:textSize="16sp"
                android:text="@string/ng_settings_natural" />
            <TextView
                android:id="@+id/settings_scroll_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ng_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="@color/ng_text_secondary"
                android:text="@string/ng_settings_keyboard" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/settings_auto_clear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:saveEnabled="false"
                android:textColor="@color/ng_text_primary"
                android:textSize="16sp"
                android:text="@string/ng_settings_auto_clear" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ng_text_secondary"
                android:text="@string/ng_settings_explicit_send" />

            <Button
                android:id="@+id/settings_advanced"
                style="@style/Widget.XMouseNg.ControlButton.Soft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:singleLine="false"
                android:textAllCaps="false"
                android:text="@string/ng_settings_advanced" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ng_text_secondary"
                android:text="@string/ng_settings_advanced_help" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/ng_text_secondary"
                android:text="@string/ng_settings_appearance" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
