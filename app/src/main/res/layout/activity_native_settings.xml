<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ng_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/ng_page_gutter" android:paddingEnd="@dimen/ng_page_gutter"
        android:paddingTop="12dp" android:paddingBottom="16dp">
        <ImageButton
            android:id="@+id/settings_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ng_settings_back"
            android:padding="12dp"
            android:src="@drawable/ic_ng_arrow_back"
            app:tint="@color/ng_text_primary"
            android:tooltipText="@string/ng_settings_back" />
        <TextView
            android:id="@+id/settings_title"
            style="@style/TextAppearance.XMouseNg.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/title_activity_settings" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ng_page_gutter"
            android:paddingEnd="@dimen/ng_page_gutter"
            android:paddingBottom="@dimen/ng_page_bottom">

            <LinearLayout android:id="@+id/settings_pointer_section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <Button android:id="@+id/settings_pointer_speed" style="@style/Widget.XMouseNg.ControlButton.Soft"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="start|center_vertical" android:singleLine="false" android:textAllCaps="false"
                    android:saveEnabled="false" android:text="@string/ng_settings_pointer_speed" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="@color/ng_text_secondary"
                    android:textSize="12sp" android:text="@string/ng_settings_pointer_help" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/settings_natural_scroll"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:minWidth="48dp" android:minHeight="48dp" android:saveEnabled="false"
                    android:textColor="@color/ng_text_primary" android:textSize="14sp"
                    android:text="@string/ng_settings_natural" />
                <TextView android:id="@+id/settings_scroll_description" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/ng_text_secondary" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/settings_keyboard_section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/ng_text_secondary" android:textSize="12sp"
                    android:text="@string/ng_settings_keyboard" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/settings_auto_clear"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minWidth="48dp"
                    android:minHeight="48dp" android:saveEnabled="false" android:textColor="@color/ng_text_primary"
                    android:textSize="14sp" android:text="@string/ng_settings_auto_clear" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/ng_text_secondary" android:textSize="12sp"
                    android:text="@string/ng_settings_auto_clear_help" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/settings_send_enter"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minWidth="48dp"
                    android:minHeight="48dp" android:saveEnabled="false" android:textColor="@color/ng_text_primary"
                    android:textSize="14sp" android:text="@string/ng_settings_send_enter" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/ng_text_secondary" android:textSize="12sp"
                    android:text="@string/ng_settings_send_enter_help" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="@color/ng_text_secondary"
                    android:textSize="12sp" android:text="@string/ng_settings_explicit_send" />
            </LinearLayout>

            <LinearLayout android:id="@+id/settings_advanced_section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical">
                <Button android:id="@+id/settings_advanced" style="@style/Widget.XMouseNg.ControlButton.Soft"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="false"
                    android:textAllCaps="false" android:text="@string/ng_settings_advanced" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="@color/ng_text_secondary"
                    android:textSize="12sp" android:text="@string/ng_settings_advanced_help" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
