<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/destination_container" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:id="@+id/touchpad_destination" android:layout_width="match_parent"
        android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent"
         android:layout_height="wrap_content" android:orientation="vertical"
         android:paddingStart="@dimen/ng_page_gutter" android:paddingEnd="@dimen/ng_page_gutter"
         android:paddingTop="0dp" android:paddingBottom="0dp">
        <FrameLayout android:id="@+id/touchpad_mode_host" android:layout_width="match_parent"
            android:layout_height="176dp" android:layout_weight="1" android:minHeight="176dp">
            <LinearLayout android:id="@+id/mouse" android:layout_width="match_parent"
                android:layout_height="match_parent" android:orientation="vertical">
                <FrameLayout android:id="@+id/mouse_surface_host" android:layout_width="match_parent"
                    android:layout_height="0dp" android:layout_weight="1" android:minHeight="112dp"
                    android:background="@drawable/ng_touchpad_surface"
                    android:foreground="@drawable/ng_touchpad_outline"
                    android:importantForAccessibility="no">
                    <Button android:id="@+id/fourthMouseButton" style="@style/Widget.XMouseNg.IconButton.Transparent"
                        android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|right"
                        android:contentDescription="@string/mouse_control_scroll_up"
                        app:icon="@drawable/ic_ng_chevron_up" app:iconGravity="textStart" app:iconPadding="0dp"
                        android:gravity="center" android:onClick="xMouseClickMouse" android:padding="16dp"
                        android:tooltipText="@string/mouse_control_scroll_up_tooltip" />
                    <Button android:id="@+id/fifthMouseButton" style="@style/Widget.XMouseNg.IconButton.Transparent"
                        android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="bottom|right"
                        android:contentDescription="@string/mouse_control_scroll_down"
                        app:icon="@drawable/ic_ng_chevron_down" app:iconGravity="textStart" app:iconPadding="0dp"
                        android:gravity="center" android:onClick="xMouseClickMouse" android:padding="16dp"
                        android:tooltipText="@string/mouse_control_scroll_down_tooltip" />
                </FrameLayout>
                <include layout="@layout/mouse_buttons" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:id="@+id/touchpad_quick_keys" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/ng_touchpad_control_gap" android:orientation="horizontal"
            android:baselineAligned="false">
            <Button android:id="@+id/typing_key_escape" style="@style/Widget.XMouseNg.ControlButton.Soft"
                android:layout_width="0dp" android:layout_height="@dimen/ng_min_touch_target" android:layout_weight="1"
                android:minWidth="@dimen/ng_min_touch_target" android:minHeight="@dimen/ng_min_touch_target"
                android:paddingStart="3dp" android:paddingEnd="3dp" android:text="@string/ng_escape" android:textSize="11sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/typing_key_tab"
                style="@style/Widget.XMouseNg.ControlButton.Soft" android:layout_width="0dp"
                android:layout_height="@dimen/ng_min_touch_target" android:layout_weight="1"
                android:layout_marginStart="@dimen/ng_touchpad_control_gap" android:minWidth="@dimen/ng_min_touch_target"
                android:minHeight="@dimen/ng_min_touch_target" android:contentDescription="@string/ng_tab"
                android:tooltipText="@string/ng_tab" android:gravity="center"
                app:icon="@drawable/ic_ng_tab" app:iconGravity="textStart" app:iconPadding="0dp"
                app:iconTint="@color/ng_text_primary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/typing_key_backspace"
                style="@style/Widget.XMouseNg.ControlButton.Soft" android:layout_width="0dp"
                android:layout_height="@dimen/ng_min_touch_target" android:layout_weight="1"
                android:layout_marginStart="@dimen/ng_touchpad_control_gap" android:minWidth="@dimen/ng_min_touch_target"
                android:minHeight="@dimen/ng_min_touch_target" android:contentDescription="@string/ng_backspace"
                android:tooltipText="@string/ng_backspace" android:gravity="center"
                app:icon="@drawable/ic_ng_backspace" app:iconGravity="textStart" app:iconPadding="0dp"
                app:iconTint="@color/ng_text_primary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/typing_key_enter"
                style="@style/Widget.XMouseNg.ControlButton.Soft" android:layout_width="0dp"
                android:layout_height="@dimen/ng_min_touch_target" android:layout_weight="1"
                android:layout_marginStart="@dimen/ng_touchpad_control_gap" android:minWidth="@dimen/ng_min_touch_target"
                android:minHeight="@dimen/ng_min_touch_target" android:contentDescription="@string/ng_enter"
                android:tooltipText="@string/ng_enter" android:gravity="center"
                app:icon="@drawable/ic_ng_enter" app:iconGravity="textStart" app:iconPadding="0dp"
                app:iconTint="@color/ng_text_primary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/touchpad_clipboard_send"
                style="@style/Widget.XMouseNg.ControlButton.Soft" android:layout_width="0dp"
                android:layout_height="@dimen/ng_min_touch_target" android:layout_weight="1"
                android:layout_marginStart="@dimen/ng_touchpad_control_gap" android:minWidth="@dimen/ng_min_touch_target"
                android:minHeight="@dimen/ng_min_touch_target" android:contentDescription="@string/clipboard_send_title"
                android:tooltipText="@string/clipboard_send_tooltip" android:gravity="center"
                app:icon="@drawable/ic_ng_clipboard_send" app:iconGravity="textStart" app:iconPadding="0dp"
                app:iconTint="@color/ng_text_primary" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/actions_destination" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
        <ScrollView android:id="@+id/actions_scroll" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"
            android:clipToPadding="false">
            <LinearLayout android:id="@+id/actions_content" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingStart="@dimen/ng_page_gutter" android:paddingEnd="@dimen/ng_page_gutter"
                android:paddingBottom="@dimen/ng_page_bottom">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp" android:gravity="center_vertical" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/actions_layout_picker"
                    style="@style/Widget.XMouseNg.ControlButton" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    app:icon="@drawable/ic_ng_chevron_down" app:iconGravity="end" app:iconTint="@color/ng_text_secondary" app:iconSize="16dp"
                    android:gravity="center_vertical|start" android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:text="@string/ng_actions_choose_layout" android:textAlignment="viewStart" />
                    <Button android:id="@+id/actions_edit" style="@style/Widget.XMouseNg.ControlButton.Text"
                        android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp"
                        android:text="@string/ng_edit_actions_short" />
                </LinearLayout>
                <LinearLayout android:id="@+id/actions_tiles" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
        <!-- Retained only as an inaccessible legacy adapter host; the primary Actions UI is above. -->
        <LinearLayout android:id="@+id/keyboard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:visibility="gone" android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical">
            <include layout="@layout/drag_and_drop" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/scripts_destination" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
        <ScrollView android:id="@+id/scripts_scroll" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"
            android:clipToPadding="false">
             <LinearLayout android:id="@+id/scripts_content" android:layout_width="match_parent"
                 android:layout_height="wrap_content" android:orientation="vertical"
                 android:paddingStart="@dimen/ng_page_gutter" android:paddingEnd="@dimen/ng_page_gutter"
                 android:paddingTop="@dimen/ng_page_heading_gap" android:paddingBottom="@dimen/ng_page_bottom">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/scripts_title" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/ng_scripts" android:textColor="@color/ng_text_primary"
                        android:textSize="20sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:id="@+id/scripts_count" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:gravity="end|center_vertical"
                        android:textColor="@color/ng_text_secondary" android:textSize="12sp"
                        android:fontFamily="sans-serif" android:visibility="gone" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:baselineAligned="false"
                    android:layout_marginTop="@dimen/ng_page_heading_gap"
                    android:layout_marginBottom="@dimen/ng_page_heading_gap">
                    <com.google.android.material.button.MaterialButton android:id="@+id/scripts_add"
                        style="@style/Widget.XMouseNg.ControlButton.Accent"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginEnd="@dimen/ng_touchpad_control_gap"
                        android:minHeight="@dimen/ng_min_touch_target" android:text="@string/ng_add_script"
                        app:icon="@drawable/ic_ng_add" app:iconGravity="textStart" app:iconPadding="6dp"
                        app:iconTint="@color/ng_on_accent" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/scripts_manage"
                        style="@style/Widget.XMouseNg.ControlButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:minHeight="@dimen/ng_min_touch_target" android:contentDescription="@string/ng_manage_scripts"
                        android:tooltipText="@string/ng_manage_scripts" android:text="@string/ng_manage_scripts_short"
                        app:icon="@drawable/ic_ng_scripts" app:iconGravity="textStart" app:iconPadding="6dp"
                        app:iconTint="@color/ng_accent" />
                </LinearLayout>
                <LinearLayout android:id="@+id/scripts_list" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <TextView android:id="@+id/recentCmd" android:layout_width="0dp" android:layout_height="0dp"
        android:importantForAccessibility="no" />
</FrameLayout>
