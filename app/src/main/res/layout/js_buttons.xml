<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/js_firstMouseButton"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:contentDescription="@string/mouse_control_left_click"
            android:drawableTop="@drawable/ic_mouse_left_click"
            android:drawableTint="@color/mouse_control_icon_tint"
            android:gravity="center"
            android:onClick="xMouseClickMouse"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:tooltipText="@string/mouse_control_left_click_tooltip"
            app:layout_constraintEnd_toStartOf="@id/js_secondMouseButton"
            app:layout_constraintStart_toEndOf="@id/js_fifthMouseButton"
            app:layout_constraintTop_toTopOf="parent" />


        <Button
            android:id="@+id/js_secondMouseButton"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:contentDescription="@string/mouse_control_middle_click"
            android:drawableTop="@drawable/ic_mouse_middle_click"
            android:drawableTint="@color/mouse_control_icon_tint"
            android:gravity="center"
            android:onClick="xMouseClickMouse"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:tooltipText="@string/mouse_control_middle_click_tooltip"
            app:layout_constraintEnd_toStartOf="@id/js_thirdMouseButton"
            app:layout_constraintStart_toEndOf="@id/js_firstMouseButton"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/js_thirdMouseButton"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:contentDescription="@string/mouse_control_right_click"
            android:drawableTop="@drawable/ic_mouse_right_click"
            android:drawableTint="@color/mouse_control_icon_tint"
            android:gravity="center"
            android:onClick="xMouseClickMouse"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:tooltipText="@string/mouse_control_right_click_tooltip"
            app:layout_constraintEnd_toStartOf="@id/js_fourthMouseButton"
            app:layout_constraintStart_toEndOf="@id/js_secondMouseButton"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/js_fourthMouseButton"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:contentDescription="@string/mouse_control_scroll_up"
            android:drawableTop="@drawable/ic_mouse_scroll_up"
            android:drawableTint="@color/mouse_control_icon_tint"
            android:gravity="center"
            android:onClick="xMouseClickMouse"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:tooltipText="@string/mouse_control_scroll_up_tooltip"
            app:layout_constraintEnd_toStartOf="@id/js_jsToggle"
            app:layout_constraintStart_toEndOf="@id/js_thirdMouseButton"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/js_fifthMouseButton"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:contentDescription="@string/mouse_control_scroll_down"
            android:drawableTop="@drawable/ic_mouse_scroll_down"
            android:drawableTint="@color/mouse_control_icon_tint"
            android:gravity="center"
            android:onClick="xMouseClickMouse"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:tooltipText="@string/mouse_control_scroll_down_tooltip"
            app:layout_constraintEnd_toStartOf="@id/js_firstMouseButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <!--
            <ToggleButton
                android:id="@+id/js_gyroToggle"
                android:layout_width="0dp"
                android:layout_height="60dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/js_fifthMouseButton"
                app:layout_constraintTop_toTopOf="parent" />-->
        <Button
            android:id="@+id/js_jsToggle"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:contentDescription="@string/joystick_control_show_touchpad"
            android:drawableTop="@drawable/ic_mouse_touchpad"
            android:drawableTint="@color/mouse_control_icon_tint"
            android:gravity="center"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:tooltipText="@string/joystick_control_show_touchpad_tooltip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/js_fourthMouseButton"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
