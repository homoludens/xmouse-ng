<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/native_shell" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:id="@+id/shell_header" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingStart="14dp" android:paddingEnd="6dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <LinearLayout android:id="@+id/computer_selector" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent" android:minHeight="72dp"
            android:background="?attr/selectableItemBackground" android:gravity="center_vertical"
            android:focusable="true" android:clickable="true" android:orientation="horizontal"
            android:contentDescription="@string/ng_choose_computer">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
                android:src="@drawable/ic_ng_computer" android:background="@drawable/ng_accent_surface"
                android:importantForAccessibility="no" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="4dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/app_name" android:textSize="11sp" android:textColor="@color/ng_text_secondary" />
                <TextView android:id="@+id/computer_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/ng_choose_computer" android:textSize="19sp" android:maxLines="2" android:ellipsize="end"
                    android:drawableEnd="@drawable/ic_ng_chevron_down" android:drawablePadding="4dp"
                    android:textColor="@color/ng_text_primary" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="96dp" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
                <ImageButton android:id="@+id/header_settings" android:layout_width="48dp" android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp"
                    android:src="@drawable/ic_ng_settings" android:contentDescription="@string/action_settings" />
                <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="48dp"
                    android:layout_height="48dp" app:contentInsetStart="0dp" app:contentInsetEnd="0dp"
                    android:minHeight="48dp" app:popupTheme="@style/AppTheme.PopupOverlay" />
            </LinearLayout>
            <TextView android:id="@+id/connection_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center"
                android:padding="2dp" android:textSize="11sp" android:text="@string/ng_disconnected"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/ng_text_secondary" android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:id="@+id/shell_content" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1">
        <include layout="@layout/content_main" />
        <include layout="@layout/ng_shell_overlay" />
    </FrameLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ng_border" />
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottom_navigation"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp"
        android:background="@color/ng_surface" app:menu="@menu/ng_bottom_navigation"
        app:labelVisibilityMode="labeled" app:itemHorizontalTranslationEnabled="false"
        app:itemIconTint="@color/ng_navigation_tint" app:itemTextColor="@color/ng_navigation_tint" />
</LinearLayout>
