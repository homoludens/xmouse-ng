<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mouse_click_controls"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp">

    <Button
        android:id="@+id/firstMouseButton"
        style="@style/Widget.XMouseNg.ControlButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:contentDescription="@string/mouse_control_left_click"
        app:icon="@drawable/ic_mouse_left_click"
        app:iconTint="@color/mouse_control_icon_tint"
        app:iconPadding="4dp"
        app:iconGravity="textStart"
        android:gravity="center"
        android:onClick="xMouseClickMouse"
        android:text="@string/ng_left_click"
        android:tooltipText="@string/mouse_control_left_click_tooltip"
        app:layout_constraintEnd_toStartOf="@id/secondMouseButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/secondMouseButton"
        style="@style/Widget.XMouseNg.ControlButton"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:contentDescription="@string/mouse_control_middle_click"
        android:drawableTop="@drawable/ic_mouse_middle_click"
        android:drawableTint="@color/mouse_control_icon_tint"
        android:gravity="center"
        android:onClick="xMouseClickMouse"
        android:padding="2dp"
        android:tooltipText="@string/mouse_control_middle_click_tooltip"
        app:layout_constraintEnd_toStartOf="@id/thirdMouseButton"
        app:layout_constraintStart_toEndOf="@id/firstMouseButton"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/thirdMouseButton"
        style="@style/Widget.XMouseNg.ControlButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:contentDescription="@string/mouse_control_right_click"
        app:icon="@drawable/ic_mouse_right_click"
        app:iconTint="@color/mouse_control_icon_tint"
        app:iconPadding="4dp"
        app:iconGravity="textEnd"
        android:gravity="center"
        android:onClick="xMouseClickMouse"
        android:text="@string/ng_right_click"
        android:tooltipText="@string/mouse_control_right_click_tooltip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/secondMouseButton"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
