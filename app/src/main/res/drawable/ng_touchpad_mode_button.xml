<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/ng_accent_soft" />
            <stroke android:width="1dp" android:color="@color/ng_accent" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/ng_border" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
